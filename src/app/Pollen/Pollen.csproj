<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsAotCompatible>true</IsAotCompatible>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\ovo.dotnet\src\Standard.Avalonia\Standard.Avalonia.csproj" />
        <ProjectReference Include="..\..\ovo.dotnet\src\Standard.Mvvm\Standard.Mvvm.csproj" />
        <ProjectReference Include="..\..\ovoui.avalonia\src\OvoUi.Fonts\OvoUi.Fonts.csproj" />
        <ProjectReference Include="..\..\ovoui.avalonia\src\OvoUi.SmoothScroll\OvoUi.SmoothScroll.csproj" />
        <ProjectReference Include="..\..\ovoui.avalonia\src\OvoUi.Tab\OvoUi.Tab.csproj" />
        <ProjectReference Include="..\Pollen.Localization\Pollen.Localization.csproj"/>
        <ProjectReference Include="..\..\ovo.dotnet\src\Standard\Standard.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
        <AvaloniaResource Include="..\..\..\assets\icon-pattern.ico" Link="Assets\Icon-Pattern.ico"/>
    </ItemGroup>
    
    <Import Project="BuildValues.props" />
    <Import Project="../../ovo.dotnet/src/Standard/Standard.targets" />
</Project>
