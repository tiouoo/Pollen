<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <StartupObject>Pollen.AotTest.Program</StartupObject>
        <PublishAot>true</PublishAot>
        <TrimMode>full</TrimMode>
        <OptimizationPreference>Size</OptimizationPreference>
        <IsAotCompatible>true</IsAotCompatible>
        <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
        <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <PublishDocumentationFiles>false</PublishDocumentationFiles>
        <ApplicationManifest>../Pollen.Desktop/app.manifest</ApplicationManifest>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" />
        <ProjectReference Include="../Pollen/Pollen.csproj" />
        <Compile Include="../Pollen.Desktop/Program.cs" Link="Desktop/Program.cs" />
        <Compile Include="../Pollen.Desktop/WindowsNativeBundle.cs" Link="Desktop/WindowsNativeBundle.cs" />
    </ItemGroup>
    <Import Project="../Pollen.Desktop/WindowsNativeBundle.targets" />
</Project>
